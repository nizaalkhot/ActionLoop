# =====================================================================
# ActionLoop Backend Environment Configuration
# Copy this file to .env in apps/api/ or project root
# =====================================================================

# ---------------------------------------------------------------------
# LLM Engine (Required for transcript extraction & benchmark)
# ---------------------------------------------------------------------
# Google Gemini API Key used by Gemini 2.5 Flash for structured task extraction
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# Fernet Token Encryption & Key Rotation
# ---------------------------------------------------------------------
# Primary encryption secret used to encrypt OAuth tokens with Fernet (AES-128-CBC + HMAC-SHA256)
ENCRYPTION_SECRET=actionloop-primary-secret-key-32-bytes!

# Optional: Comma-separated list of keys for seamless zero-downtime key rotation.
# When provided, new tokens are encrypted using the first key, while decryption falls
# back across previous keys in the list.
# ENCRYPTION_SECRET_KEYS=new-primary-key-32-bytes!,actionloop-primary-secret-key-32-bytes!

# ---------------------------------------------------------------------
# Linear Project Management Integration
# ---------------------------------------------------------------------
# Personal API Key (alternative to OAuth for single-workspace testing)
LINEAR_API_KEY=lin_api_your_personal_api_key_here

# Default Linear Team ID where issues will be created
LINEAR_TEAM_ID=your_linear_team_id_here

# Linear OAuth 2.0 App credentials (for multi-workspace SaaS onboarding)
# Create your OAuth application at: https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=your_linear_oauth_client_id
LINEAR_CLIENT_SECRET=your_linear_oauth_client_secret
LINEAR_REDIRECT_URI=http://localhost:8000/api/auth/linear/callback

