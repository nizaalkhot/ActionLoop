# =====================================================================
# ActionLoop: Meeting Notes into Deduplicated Tasks (Mini-SaaS)
# Unified Environment Configuration Example
# =====================================================================

# ---------------------------------------------------------------------
# Backend Configuration (apps/api/.env)
# ---------------------------------------------------------------------

# 1. LLM Engine (Required)
# Gemini API Key used by Gemini 2.5 Flash with strict structured JSON schemas
# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Token Encryption (Fernet: AES-128-CBC with HMAC-SHA256)
# Primary secret key used to encrypt sensitive OAuth access/refresh tokens in the DB
ENCRYPTION_SECRET=actionloop-primary-secret-key-32-bytes!

# Optional: Comma-separated list for zero-downtime key rotation
# ENCRYPTION_SECRET_KEYS=new-primary-key-32-bytes!,actionloop-primary-secret-key-32-bytes!

# 3. Linear Project Management Integration
# Option A: Direct Personal API Key
LINEAR_API_KEY=lin_api_your_personal_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here

# Option B: Multi-Workspace OAuth 2.0 Application
# Register an app in Linear: https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=your_linear_oauth_client_id
LINEAR_CLIENT_SECRET=your_linear_oauth_client_secret
LINEAR_REDIRECT_URI=http://localhost:8000/api/auth/linear/callback

# ---------------------------------------------------------------------
# Frontend Configuration (apps/web/.env.local)
# ---------------------------------------------------------------------
# URL of the running FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

